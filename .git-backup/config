[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/SOLVEXO/solvexo-web.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "uzair-branch"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/uzair-branch
[branch "ahad-branch"]
	remote = origin
	merge = refs/heads/ahad-branch
	vscode-merge-base = origin/ahad-branch
[lfs]
	repositoryformatversion = 0
[branch "staging"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/staging
